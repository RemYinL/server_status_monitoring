# =============================================================================
# secrets.toml.example —— 秘密模板（agent 与 relay 各一份，内容不同）
# =============================================================================
#
# ⚠️⚠️ 重要 ⚠️⚠️
#   1. 本文件是**模板**，只含占位符。真实 secrets.toml **绝对不要提交进 git**
#      （仓库 .gitignore 已排除 `secrets.toml`）。
#   2. install.sh **不会**替你生成 secrets —— 必须手工创建并 chmod 600：
#
#        sudo install -m 0600 -o ssm-agent -g ssm-agent \
#             deploy/secrets.toml.example /etc/ssm-agent/secrets.toml
#        sudo install -m 0600 -o ssm-relay -g ssm-relay \
#             deploy/secrets.toml.example /etc/ssm-relay/secrets.toml
#
#      然后按下面的说明填入真实值；改完 `systemctl restart ssm-agent ssm-relay`。
#   3. 两份 secrets.toml 中 `shared_secret` **必须是同一条字符串**，
#      否则 agent 的上报会被 relay 以 401 拒绝（docs/06 用例 T9）。
#   4. 生成随机密钥（不要手打）：
#        openssl rand -hex 32
#
# =============================================================================
# 【A】/etc/ssm-agent/secrets.toml 需要：shared_secret
# 【B】/etc/ssm-relay/secrets.toml 需要：shared_secret + status_token + [bark]
#        下面这份是**合集模板**，按需删掉用不到的行即可。
# =============================================================================

# agent ↔ relay 的 HMAC-SHA256 共享密钥（SPEC.md §5）。
# 签名算法：HMAC_SHA256(shared_secret, "<unix 秒>" || raw_body)，十六进制小写。
# 两端必须完全一致。建议值：64 个十六进制字符（32 字节熵），如 openssl rand -hex 32 的输出。
shared_secret = "CHANGE_ME_shared_secret_64_hex_chars"

# relay 的 GET /status Bearer Token（iPhone 小组件用）。
# 仅 relay 侧需要；要填进 Scriptable 脚本的 TOKEN 或小组件 Parameter。
# 建议值：再跑一次 openssl rand -hex 32，**不要**与 shared_secret 用同一个值。
status_token = "CHANGE_ME_status_token_64_hex_chars"

# Bark 推送（relay 侧，docs/04 §3）
[bark]
# Bark 服务端点。官方：https://api.day.app ；自建：http(s)://<你的 bark server>。
# relay 需要到该地址的**出站** HTTPS，无需入站映射（docs/07 §3）。
endpoint = "https://api.day.app"

# Bark key：Bark App「服务器」页里推送 URL 中的那串字符。
# 泄露等于任何人都能往你手机推通知，务必 600 保存。
key = "CHANGE_ME_bark_key"

# iOS 通知分组名，便于把服务器告警聚合到一起（docs/04 §3）。
# 保持 "server_status" 即可，不需要改。
group = "server_status"

# =============================================================================
# 创建后自检：
#   sudo ls -l /etc/ssm-agent/secrets.toml /etc/ssm-relay/secrets.toml   # 必须是 -rw------- 
#   sudo -u ssm-agent test -r /etc/ssm-agent/secrets.toml && echo agent-ok
#   sudo -u ssm-relay test -r /etc/ssm-relay/secrets.toml && echo relay-ok
# 注意：600 意味着**只有属主**能读，所以属主必须是服务运行用户（见上面的 install -o）。
# 若你图省事用 root 属主 + 600，服务会因 EACCES 起不来。
# =============================================================================
